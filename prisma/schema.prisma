generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Conversation ────────────────────────────────────────────────────────────
model Message {
  id         String   @id @default(cuid())
  sessionId  String   @default("default")
  role       String // "user" | "assistant"
  content    String
  intent     String? // detected intent slug, e.g. "reminder_set"
  route      String? // "rule" | "llm" | "tool" | "search" | "agent"
  confidence Float    @default(0)
  emotion    String? // detected emotion of user / tone of reply
  meta       String? // JSON string: trace, actions, clarify options
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
}

// ── Long-term memory (facts the user taught JARVIS) ─────────────────────────
model MemoryFact {
  id        String   @id @default(cuid())
  key       String   @unique // normalized topic, e.g. "user.name", "exam.date"
  value     String
  kind      String   @default("fact") // fact | preference | project | person
  source    String? // snippet of the message it was learned from
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ── Tasks ───────────────────────────────────────────────────────────────────
model Task {
  id        String    @id @default(cuid())
  title     String
  status    String    @default("open") // open | doing | done
  priority  String    @default("normal") // low | normal | high
  project   String?
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, updatedAt])
}

// ── Reminders (server-side so they survive reloads) ─────────────────────────
model Reminder {
  id          String    @id @default(cuid())
  title       String
  fireAt      DateTime
  status      String    @default("scheduled") // scheduled | fired | cancelled | done
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, fireAt])
}

// ── Multi-step agent runs ───────────────────────────────────────────────────
model AgentRun {
  id         String   @id @default(cuid())
  goal       String
  status     String   @default("planning") // planning | running | done | failed | cancelled
  plan       String? // JSON array of planned steps
  result     String? // final report text
  stepsTotal Int      @default(0)
  stepsDone  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AgentStep {
  id        String   @id @default(cuid())
  runId     String
  index     Int
  action    String // tool name: web_search | calc | summarize | memory_save ...
  input     String
  output    String?
  status    String   @default("pending") // pending | running | verified | failed | recovered | skipped
  note      String? // verification / recovery note
  createdAt DateTime @default(now())

  @@index([runId, index])
}

// ── Activity log (HUD feed) ─────────────────────────────────────────────────
model EventLog {
  id        String   @id @default(cuid())
  kind      String   @default("info") // info | success | warning | error | system
  message   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Settings (persona, autonomy, etc.) ──────────────────────────────────────
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
